# API Keys
# Get from https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_token_here

# Database
DATABASE_PATH=data/jobs.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/job_monitor.log

# Scheduler
RUN_INTERVAL_MINUTES=30

# Agent workflow (Phase 2)
# Add whichever key your agent stack uses.
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Root apply-decider uses a fixed OpenAI model configured in code:
# src/agents/root_apply_decider/agent.py

# How many NEW jobs to pull from DB per run
AGENT_BATCH_SIZE=100
AGENT_POLL_INTERVAL_SECONDS=60
AGENT_MAX_RETRIES=3
AGENT_RETRY_BACKOFF_SECONDS=300
AGENT_RETRY_BACKOFF_MULTIPLIER=3

# Notifications (optional: used for terminal gate failures)
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=
NTFY_PRIORITY=default

# Optional profile/config overrides
CANDIDATE_PROFILE_PATH=config/candidate_profile.yaml
SQLITE_JOURNAL_MODE=WAL
