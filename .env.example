# =============================================================================
# Environment configuration
#
# Copy this file to .env (and fill in the required values) before running.
# Both Docker (`docker compose up`) and local (`uv run`) workflows use this
# same file.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# OpenAI API key — used by the gate, tailor, and review workers.
# Workers idle gracefully if this is unset; they do not crash.
# Multi-provider BYOK (Anthropic, Gemini, OpenRouter, Codex) is tracked in #35.
OPENAI_API_KEY=your_openai_key_here

# -----------------------------------------------------------------------------
# OPTIONAL — sensible defaults are baked in
# -----------------------------------------------------------------------------

# ntfy.sh push notifications for terminal-state failures (blank = disabled)
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=
NTFY_PRIORITY=default

# How often discovery runs (minutes). Default: 30
RUN_INTERVAL_MINUTES=30

# API port exposed on the host. Default: 8000
API_PORT=8000

# CDP endpoint the apply loop uses to drive your HOST Chrome. The app no
# longer ships Chromium inside the container — start Chrome on your host
# with `--remote-debugging-port=9222` and leave this URL pointing at the
# host gateway. Override on Linux only if you forward a different port.
CHROME_CDP_URL=http://host.docker.internal:9222

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
DATABASE_PATH=data/jobs.db
SQLITE_JOURNAL_MODE=WAL

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/job_monitor.log

# -----------------------------------------------------------------------------
# GATE WORKER (scripts/process_new_jobs.py)
# -----------------------------------------------------------------------------
AGENT_BATCH_SIZE=100
AGENT_POLL_INTERVAL_SECONDS=60
AGENT_MAX_RETRIES=3
AGENT_RETRY_BACKOFF_SECONDS=300
AGENT_RETRY_BACKOFF_MULTIPLIER=3
# Skip jobs older than N days (0 = disabled, default 90)
JOB_MAX_AGE_DAYS=90

# -----------------------------------------------------------------------------
# TAILOR WORKER (scripts/process_qualified_jobs.py)
# -----------------------------------------------------------------------------
TAILOR_POLL_INTERVAL_SECONDS=30
TAILOR_MAX_RETRIES=2
TAILOR_RETRY_BACKOFF_SECONDS=600
TAILOR_RETRY_BACKOFF_MULTIPLIER=2
TAILOR_CLAIM_LEASE_SECONDS=7200
TAILOR_OUTPUT_DIR=data/tailored_resumes
TAILOR_RESUME_YAML_PATH=config/resume_content.yaml

# Model for resume tailoring (blank = built-in default `openai/gpt-5-mini`).
# Avoid coding-tuned OpenAI variants; they bail with empty edits on
# prose-rewrite tasks. See issue #53.
RESUME_TAILOR_MODEL=openai/gpt-5-mini

# -----------------------------------------------------------------------------
# REVIEW WORKER (scripts/process_reviewed_resumes.py)
# -----------------------------------------------------------------------------
REVIEW_POLL_INTERVAL_SECONDS=30
REVIEW_MAX_RETRIES=2
REVIEW_RETRY_BACKOFF_SECONDS=600
REVIEW_RETRY_BACKOFF_MULTIPLIER=2
REVIEW_CLAIM_LEASE_SECONDS=7200
REVIEW_OUTPUT_DIR=data/tailored_resumes
REVIEW_BASE_RESUME_YAML_PATH=config/resume_content.yaml
REVIEW_BASE_RESUME_TEX_PATH=data/tailored_resumes/_base_reference/resume_base.tex
REVIEW_BASE_RESUME_PDF_PATH=data/tailored_resumes/_base_reference/resume_base.pdf

# Model for resume review (blank = built-in default `openai/gpt-5-mini`).
# Same guidance as RESUME_TAILOR_MODEL — prose-tuned models only.
RESUME_REVIEWER_MODEL=openai/gpt-5-mini

# -----------------------------------------------------------------------------
# CANDIDATE CONFIG — paths relative to repo root (or /app inside container)
# -----------------------------------------------------------------------------
CANDIDATE_PROFILE_PATH=config/candidate_profile.yaml
